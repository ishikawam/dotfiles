# 個別hostの設定はprivateリポジトリのconfig.dに置く
# Includeは先頭に書く。sshは先にマッチした値が優先されるため
Include ~/private/.ssh/config.d/*

# 個別hostの設定はしない。

#StrictHostKeyChecking no
#UserKnownHostsFile /dev/null
ServerAliveInterval 50
ServerAliveCountMax 15
LogLevel ERROR

ForwardAgent yes

# Host *
#     AddKeysToAgent yes
#     UseKeychain yes
# これらはmac以外で使えないし、不要な気がするので一旦コメントアウト
# mac専用のためprivate/.ssh/config.d/macへ移した
